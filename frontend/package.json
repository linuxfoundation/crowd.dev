{
  "name": "frontend",
  "version": "0.5.0",
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "lint": "eslint \"src/**/*.{js,ts,vue}\" --max-warnings=0",
    "lint:fix": "npm run lint -- --fix",
    "lint:cycles": "node scripts/check-cycles.mjs",
    "lint:cycles:update": "node scripts/check-cycles.mjs --update",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json",
    "typecheck:ci": "node scripts/typecheck-ratchet.mjs",
    "build": "vite build",
    "build:localhost": "vite build --mode localhost",
    "build:production": "vite build --mode prod",
    "build:staging": "vite build --mode staging",
    "analyze": "ANALYZE=1 vite build --mode localhost",
    "start": "vite --host",
    "start:dev": "vite --host",
    "start:dev:local": "set -a && . ./.env.dist.local && . ./.env.override.local && set +a && vite --mode localhost --port 8081",
    "preview": "vite preview",
    "docs:tailwind": "tailwind-config-viewer -o",
    "docs:storybook": "storybook dev -p 6006",
    "docs:storybook:build": "storybook build",
    "docs:storybook:ci": "storybook build --quiet",
    "docs": "npm run docs:tailwind & npm run docs:storybook",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "lint-staged": {
    "**/!(components.d).{js,ts}": [
      "prettier --write",
      "eslint --fix --max-warnings=0"
    ],
    "**/*.vue": [
      "eslint --fix --max-warnings=0"
    ],
    "**/*.{scss,css,json,md,yml,yaml}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@auth0/auth0-spa-js": "^2.1.3",
    "@datadog/browser-rum": "^5.9.0",
    "@popperjs/core": "npm:@sxzz/popperjs-es@^2.11.7",
    "@linuxfoundation/lfx-ui-core": "^0.0.20",
    "@nangohq/frontend": "^0.9.0",
    "@sxzz/popperjs-es": "^2.11.7",
    "@tailwindcss/line-clamp": "^0.4.2",
    "@tanstack/vue-query": "^5.75.1",
    "@tanstack/vue-query-devtools": "^5.75.1",
    "@vuelidate/core": "^2.0.3",
    "@vuelidate/validators": "^2.0.4",
    "@vueuse/core": "^9.13.0",
    "axios": "^1.19.0",
    "dayjs": "^1.11.13",
    "element-plus": "^2.11.0",
    "lodash": "^4.17.23",
    "lodash-es": "^4.18.1",
    "logrocket": "^3.0.1",
    "logrocket-vuex": "^0.0.3",
    "marked": "^4.3.0",
    "node-emoji": "^1.11.0",
    "nprogress": "0.2.0",
    "pinia": "^2.0.33",
    "pluralize": "^8.0.0",
    "qs": "^6.16.0",
    "socket.io-client": "^4.8.3",
    "vue": "^3.3.1",
    "vue-3-sanitize": "^0.1.4",
    "vue-draggable-next": "^2.2.1",
    "vue-grid-layout": "3.0.0-beta1",
    "vue-router": "^4.1.6",
    "vue3-click-away": "^1.2.4",
    "vue3-lazyload": "^0.3.6",
    "vuex": "^4.1.0",
    "yup": "^0.32.11"
  },
  "devDependencies": {
    "@storybook/addon-a11y": "^10.2.12",
    "@storybook/addon-docs": "^10.2.12",
    "@storybook/vue3": "^10.2.12",
    "@storybook/vue3-vite": "^10.2.12",
    "@types/lodash": "^4.17.24",
    "@types/lodash-es": "^4.17.12",
    "@types/marked": "^4.3.2",
    "@types/node": "^24.19.0",
    "@types/pluralize": "^0.0.33",
    "@vitejs/plugin-vue": "^6.0.4",
    "@vue/eslint-config-typescript": "^14.9.0",
    "autoprefixer": "^10.4.14",
    "dotenv": "^16.0.3",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-storybook": "^10.6.1",
    "eslint-plugin-vue": "^10.11.1",
    "globals": "^17.12.0",
    "lint-staged": "^15.4.3",
    "madge": "^8.0.0",
    "postcss": "^8.5.15",
    "prettier": "^3.9.9",
    "rollup-plugin-visualizer": "^7.1.1",
    "sass": "^1.80.0",
    "storybook": "^10.2.12",
    "tailwind-config-viewer": "^1.7.2",
    "tailwindcss": "^3.2.7",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.71.0",
    "unplugin-vue-components": "^32.1.0",
    "vite": "^6.4.3",
    "vue-tsc": "^3.3.11"
  }
}
