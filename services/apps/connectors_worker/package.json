{
  "name": "@crowd/connectors-worker",
  "private": true,
  "scripts": {
    "start": "CROWD_TEMPORAL_TASKQUEUE=connectors SERVICE=connectors-worker node --import tsx src/main.ts",
    "start:debug:local": "set -a && . ../../../backend/.env.dist.local && . ../../../backend/.env.override.local && set +a && CROWD_TEMPORAL_TASKQUEUE=connectors SERVICE=connectors-worker LOG_LEVEL=trace tsx --inspect=0.0.0.0:9243 src/main.ts",
    "start:debug": "CROWD_TEMPORAL_TASKQUEUE=connectors SERVICE=connectors-worker LOG_LEVEL=trace tsx --inspect=0.0.0.0:9243 src/main.ts",
    "dev:local": "nodemon --watch src --watch ../../libs --ext ts --exec pnpm run start:debug:local",
    "dev": "nodemon --watch src --watch ../../libs --ext ts --exec pnpm run start:debug",
    "script:audit-github-app-budget": "tsx src/bin/audit-github-app-budget.ts",
    "script:backfill-octolens-mentions": "tsx src/bin/backfill-octolens-mentions.ts",
    "script:validate-completeness": "tsx src/bin/validate-completeness.ts",
    "script:probe-credly-api": "tsx src/bin/probe-credly-api.ts",
    "script:dry-run-credly-badge-poll": "tsx src/bin/dry-run-credly-badge-poll.ts",
    "script:resolve-credly-templates": "tsx src/bin/resolve-credly-templates.ts",
    "script:migrate-credly-mapped-templates": "tsx src/bin/migrate-credly-mapped-templates.ts",
    "script:backfill-stale-credly-templates": "tsx src/bin/backfill-stale-credly-templates.ts"
  },
  "dependencies": {
    "@crowd/archetype-standard": "workspace:*",
    "@crowd/archetype-worker": "workspace:*",
    "@crowd/common": "workspace:*",
    "@crowd/connectors": "workspace:*",
    "@crowd/data-access-layer": "workspace:*",
    "@crowd/database": "workspace:*",
    "@crowd/logging": "workspace:*",
    "@crowd/nango": "workspace:*",
    "@crowd/project-onboarding": "workspace:*",
    "@crowd/redis": "workspace:*",
    "@crowd/slack": "workspace:*",
    "@crowd/snowflake": "workspace:*",
    "@crowd/temporal": "workspace:*",
    "@crowd/types": "workspace:*",
    "@temporalio/activity": "~1.17.2",
    "@temporalio/client": "~1.17.2",
    "@temporalio/workflow": "~1.17.2",
    "axios": "catalog:",
    "tsx": "^4.7.1"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "nodemon": "^3.0.1",
    "typescript": "catalog:"
  }
}
