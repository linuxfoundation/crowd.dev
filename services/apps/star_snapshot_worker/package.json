{
  "name": "@crowd/star-snapshot-worker",
  "private": true,
  "scripts": {
    "start": "CROWD_TEMPORAL_TASKQUEUE=star-snapshot SERVICE=star-snapshot-worker tsx src/main.ts",
    "start:debug:local": "set -a && . ../../../backend/.env.dist.local && . ../../../backend/.env.override.local && set +a && CROWD_TEMPORAL_TASKQUEUE=star-snapshot SERVICE=star-snapshot-worker LOG_LEVEL=trace tsx --inspect=0.0.0.0:9232 src/main.ts",
    "start:debug": "CROWD_TEMPORAL_TASKQUEUE=star-snapshot SERVICE=star-snapshot-worker LOG_LEVEL=info tsx --inspect=0.0.0.0:9232 src/main.ts",
    "dev:local": "nodemon --watch src --watch ../../libs --ext ts --exec pnpm run start:debug:local",
    "dev": "nodemon --watch src --watch ../../libs --ext ts --exec pnpm run start:debug",
    "backfill:star-snapshot": "tsx src/bin/star-snapshot-backfill.ts",
    "backfill:star-snapshot:local": "set -a && . ../../../backend/.env.dist.local && . ../../../backend/.env.override.local && set +a && tsx src/bin/star-snapshot-backfill.ts",
    "seed:star-backfill-status": "tsx src/bin/seed-star-backfill-status.ts",
    "seed:star-backfill-status:local": "set -a && . ../../../backend/.env.dist.local && . ../../../backend/.env.override.local && set +a && tsx src/bin/seed-star-backfill-status.ts"
  },
  "dependencies": {
    "@crowd/archetype-standard": "workspace:*",
    "@crowd/archetype-worker": "workspace:*",
    "@crowd/common": "workspace:*",
    "@crowd/common_services": "workspace:*",
    "@crowd/data-access-layer": "workspace:*",
    "@crowd/logging": "workspace:*",
    "@crowd/redis": "workspace:*",
    "@crowd/types": "workspace:*",
    "@temporalio/client": "catalog:",
    "@temporalio/workflow": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "nodemon": "^3.0.1"
  }
}
