DESCRIPTION >
    Temporary measurement, step 2 of the change detection for the daily aggregate sinks: reads the
    changed leaf keys from cdp_segment_aggregates_diff_tmp_ds, recomputes from v2 the parent and
    grandparent keys above them (old and new parents), and appends them; keys with no leaf left are
    marked gone. To be deleted after the measurement (linuxfoundation/lfx-cdp-insights-ops#1146).

NODE segment_hierarchy
SQL >
    SELECT
        id,
        argMax(parentId, updatedAt) AS parentId,
        argMax(grandparentId, updatedAt) AS grandparentId
    FROM segments
    GROUP BY id

NODE affected
SQL >
    SELECT DISTINCT kind, t.1 AS level, t.2 AS segmentId, entityId
    FROM cdp_segment_aggregates_diff_tmp_ds
    ARRAY JOIN
        [
            ('parent', currentParent),
            ('parent', sentParent),
            ('grandparent', currentGrandparent),
            ('grandparent', sentGrandparent)
        ] AS t
    WHERE level = 'leaf' AND t.2 != ''

NODE member_rollups
SQL >
    SELECT
        'member' AS kind,
        t.1 AS level,
        t.2 AS segmentId,
        memberId AS entityId,
        countMerge(activityCountState) AS activityCount,
        toUInt64(0) AS memberCount,
        maxMerge(lastActiveState) AS lastActive
    FROM
        (
            SELECT a.memberId, a.activityCountState, a.lastActiveState, h.parentId, h.grandparentId
            FROM cdp_member_segment_aggregates_v2_ds a
            INNER JOIN segment_hierarchy h ON h.id = a.segmentId
            WHERE a.memberId IN (SELECT entityId FROM affected WHERE kind = 'member')
        )
    ARRAY JOIN [('parent', parentId), ('grandparent', grandparentId)] AS t
    WHERE ('member', t.1, t.2, memberId) IN (SELECT kind, level, segmentId, entityId FROM affected)
    GROUP BY t.1, t.2, memberId

NODE organization_rollups
SQL >
    SELECT
        'organization' AS kind,
        t.1 AS level,
        t.2 AS segmentId,
        organizationId AS entityId,
        countMerge(activityCountState) AS activityCount,
        toUInt64(countDistinctMerge(memberCountState)) AS memberCount,
        maxMerge(lastActiveState) AS lastActive
    FROM
        (
            SELECT
                a.organizationId, a.activityCountState, a.memberCountState, a.lastActiveState,
                h.parentId, h.grandparentId
            FROM cdp_organization_segment_aggregates_v2_ds a
            INNER JOIN segment_hierarchy h ON h.id = a.segmentId
            WHERE a.organizationId IN (SELECT entityId FROM affected WHERE kind = 'organization')
        )
    ARRAY JOIN [('parent', parentId), ('grandparent', grandparentId)] AS t
    WHERE ('organization', t.1, t.2, organizationId) IN (SELECT kind, level, segmentId, entityId FROM affected)
    GROUP BY t.1, t.2, organizationId

NODE cdp_segment_aggregates_rollup_tmp_copy_result
SQL >
    SELECT
        a.kind AS kind,
        a.level AS level,
        if(r.entityId = '', 'gone', 'recomputed') AS reason,
        a.segmentId AS segmentId,
        a.entityId AS entityId,
        '' AS currentParent,
        '' AS sentParent,
        '' AS currentGrandparent,
        '' AS sentGrandparent,
        r.activityCount AS activityCount,
        r.memberCount AS memberCount,
        r.lastActive AS lastActive,
        now() AS updatedAt
    FROM affected a
    LEFT JOIN
        (
            SELECT * FROM member_rollups
            UNION ALL
            SELECT * FROM organization_rollups
        ) r
        ON r.kind = a.kind AND r.level = a.level AND r.segmentId = a.segmentId AND r.entityId = a.entityId

TYPE COPY
TARGET_DATASOURCE cdp_segment_aggregates_diff_tmp_ds
COPY_MODE append
COPY_SCHEDULE @on-demand
