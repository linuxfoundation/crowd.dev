DESCRIPTION >
    - `cncf_organization_countries_monthly_copy.pipe` materializes `cncf_organization_countries_monthly_ds` from `cncf_collection_activities_ds`: one row per month, organization and country.
    - An organization's country comes from its place (country, else location) matched against `country_mapping_ds` names. A place can match several countries; a match whose name sits inside another match's name (Oman in Romania, Niger in Nigeria) is dropped.
    - Matching runs once per distinct place, about a thousand, instead of once per organization and period on every request.
    - Activities dated 1980 or earlier are placeholder timestamps and are left out.
    - Runs daily at 11:50 UTC, after `cncf_collection_activities_copy.pipe` (11:30 UTC, about 3 minutes) refreshes its source.
    - Full-replace, since the source is itself a daily full replace.

TAGS "Report"

NODE cncf_organization_countries_monthly_copy_countries
SQL >
    SELECT groupArray((country, flag, country_code)) AS countries
    FROM country_mapping_ds
    WHERE country_code != 'XX'

NODE cncf_organization_countries_monthly_copy_places
SQL >
    SELECT
        place,
        arrayFilter(
            x -> position(place, upper(x .1)) > 0,
            (SELECT countries FROM cncf_organization_countries_monthly_copy_countries)
        ) AS matched,
        arrayFilter(
            x -> NOT arrayExists(y -> y .1 != x .1 AND position(upper(y .1), upper(x .1)) > 0, matched),
            matched
        ) AS countries,
        arrayJoin(countries) AS c,
        c .1 AS country,
        c .2 AS flag,
        c .3 AS country_code
    FROM
        (
            SELECT DISTINCT organizationPlace AS place
            FROM cncf_collection_activities_ds
            WHERE organizationPlace != ''
        )

NODE cncf_organization_countries_monthly_copy_result
SQL >
    SELECT
        a.month AS month,
        a.organizationId AS organizationId,
        p.country AS country,
        p.flag AS flag,
        p.country_code AS country_code
    FROM
        (
            SELECT DISTINCT toStartOfMonth(timestamp) AS month, organizationId, organizationPlace
            FROM cncf_collection_activities_ds
            WHERE organizationId != '' AND organizationPlace != '' AND timestamp > '1980-01-01'
        ) AS a
    INNER JOIN cncf_organization_countries_monthly_copy_places AS p ON p.place = a.organizationPlace

TYPE COPY
TARGET_DATASOURCE cncf_organization_countries_monthly_ds
COPY_MODE replace
COPY_SCHEDULE 50 11 * * *
