DESCRIPTION >
    On demand, one bucket at a time (bucket_id 0-4): sends every member parent segment aggregate in v2 to
    Postgres memberSegmentsAgg through Kafka, for the one-time backfill that replaces the inflated v1 numbers.
    updatedAt is the send time, so rows the backfill did not rewrite can be found afterwards
    (linuxfoundation/lfx-cdp-insights-ops#1146).

NODE parent_segment_aggregates
SQL >
    %
    SELECT
        parentId as segmentId,
        cdp_aggs.memberId,
        '875c38bd-2b1b-4e91-ad07-0cfbabb4c49f' AS tenantId,
        countMerge(cdp_aggs.activityCountState) AS activityCount,
        maxMerge(cdp_aggs.lastActiveState) AS lastActive,
        groupArrayDistinctMerge(cdp_aggs.activityTypesState) AS activityTypes,
        groupArrayDistinctMerge(cdp_aggs.activeOnState) AS activeOn,
        if(
            isFinite(avgMerge(cdp_aggs.averageSentimentState)),
            avgMerge(cdp_aggs.averageSentimentState),
            NULL
        ) AS averageSentiment,
        now() AS updatedAt
    FROM cdp_member_segment_aggregates_v2_ds cdp_aggs
    join
        (
            SELECT
                id,
                argMax(parentId, updatedAt) AS parentId,
                argMax(grandparentId, updatedAt) AS grandparentId
            FROM segments
            GROUP BY id
        ) s
        on s.id = cdp_aggs.segmentId
    WHERE
        s.parentId <> ''
        {% if defined(bucket_id) %}
            AND cityHash64(parentId) % 5
            = {{
                UInt8(
                    bucket_id,
                    0,
                    description="This is bucket id of the activity segment",
                    required=False,
                )
            }}
        {% end %}
    GROUP BY parentId, memberId

TYPE SINK
EXPORT_SERVICE kafka
EXPORT_CONNECTION_NAME lfx-oracle-kafka-streaming
EXPORT_SCHEDULE @on-demand
EXPORT_FORMAT csv
EXPORT_STRATEGY @new
EXPORT_KAFKA_TOPIC memberSegmentsAgg_sink
