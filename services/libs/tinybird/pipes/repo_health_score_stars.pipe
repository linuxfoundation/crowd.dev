DESCRIPTION >
    - Calculates repository-level stars health score.
    - Returns star count and benchmark (0-5) per repository.
    - Parameters:
    - `repoUrl`: Optional repository URL for single-repo mode
    - `startDate`: Unused - stars is a cumulative total, not a period count
    - `endDate`: Optional DateTime, returns cumulative stars as of this date

TAGS "Repository health", "Metrics"

NODE repo_health_score_stars_score
SQL >
    %
    SELECT channel, sum(stars) AS stars
    FROM
        (
            {% if defined(repoUrl) %}
                SELECT r.url AS channel, toUInt64(s.starCount) AS stars
                FROM
                    (
                        SELECT repositoryId, argMax(starCount, (capturedAt, updatedAt)) AS starCount
                        FROM repositoryStarSnapshots
                        WHERE
                            repositoryId IN (
                                SELECT r2.id
                                FROM repositories r2 FINAL
                                WHERE
                                    isNull (r2.deletedAt)
                                    AND r2.enabled = true
                                    AND r2.excluded = false
                                    AND lower(r2.url) = lower(
                                        {{
                                            String(
                                                repoUrl, description="Repository URL", required=False
                                            )
                                        }}
                                    )
                            )
                            {% if defined(endDate) %}
                                AND capturedAt
                                <= {{
                                    DateTime(
                                        endDate, description="Snapshot as of date", required=False
                                    )
                                }}
                            {% end %}
                        GROUP BY repositoryId
                    ) s
                INNER JOIN repositories r FINAL ON r.id = s.repositoryId
                WHERE
                    isNull (r.deletedAt)
                    AND r.enabled = true
                    AND r.excluded = false
                    AND lower(r.url)
                    = lower({{ String(repoUrl, description="Repository URL", required=False) }})
                UNION ALL
                SELECT channel, count() AS stars
                FROM activityRelations_deduplicated_cleaned_bucket_union
                WHERE
                    type = 'star'
                    AND platform != 'github'
                    AND channel = {{ String(repoUrl, description="Repository URL", required=False) }}
                    AND channel NOT IN (SELECT channel FROM repos_to_channels_excluded)
                    {% if defined(endDate) %}
                        AND timestamp
                        <= {{ DateTime(endDate, description="Cumulative as of date", required=False) }}
                    {% end %}
                GROUP BY channel
            {% else %}
                SELECT r.url AS channel, toUInt64(s.starCount) AS stars
                FROM
                    (
                        SELECT repositoryId, argMax(starCount, (capturedAt, updatedAt)) AS starCount
                        FROM repositoryStarSnapshots
                        GROUP BY repositoryId
                    ) s
                INNER JOIN repositories r FINAL ON r.id = s.repositoryId
                WHERE isNull (r.deletedAt) AND r.enabled = true AND r.excluded = false
                UNION ALL
                SELECT channel, count() AS stars
                FROM activityRelations_deduplicated_cleaned_bucket_union
                WHERE
                    type = 'star'
                    AND platform != 'github'
                    AND channel NOT IN (SELECT channel FROM repos_to_channels_excluded)
                GROUP BY channel
            {% end %}
        )
    GROUP BY channel

NODE health_score_stars_benchmark
SQL >
    %
    SELECT
        channel,
        stars,
        CASE
            WHEN stars BETWEEN 0 AND 9
            THEN 0
            WHEN stars BETWEEN 10 AND 49
            THEN 1
            WHEN stars BETWEEN 50 AND 199
            THEN 2
            WHEN stars BETWEEN 200 AND 499
            THEN 3
            WHEN stars BETWEEN 500 AND 999
            THEN 4
            WHEN stars >= 1000
            THEN 5
            ELSE 0
        END AS starsBenchmark
    FROM repo_health_score_stars_score
