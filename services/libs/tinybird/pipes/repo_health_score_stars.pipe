DESCRIPTION >
    - Calculates repository-level stars health score.
    - Returns star count and benchmark (0-5) per repository.
    - Parameters:
    - `repoUrl`: Optional repository URL for single-repo mode
    - `startDate`: Optional DateTime filter
    - `endDate`: Optional DateTime filter

TAGS "Repository health", "Metrics"

NODE repo_health_score_stars_score
SQL >
    %
    {% if defined(repoUrl) %}
        SELECT r.url AS channel, s.starCount AS stars
        FROM
            (
                SELECT repositoryId, argMax(starCount, capturedAt) AS starCount
                FROM repositoryStarSnapshots
                WHERE
                    1
                    {% if defined(startDate) %}
                        AND capturedAt
                        >= {{ DateTime(startDate, description="Snapshot from date", required=False) }}
                    {% end %}
                    {% if defined(endDate) %}
                        AND capturedAt
                        <= {{ DateTime(endDate, description="Snapshot as of date", required=False) }}
                    {% end %}
                GROUP BY repositoryId
            ) s
        INNER JOIN repositories r FINAL ON r.id = s.repositoryId
        WHERE
            isNull (r.deletedAt)
            AND r.enabled = true
            AND r.excluded = false
            AND r.url = {{ String(repoUrl, description="Repository URL", required=False) }}
    {% else %}
        SELECT r.url AS channel, s.starCount AS stars
        FROM
            (
                SELECT repositoryId, argMax(starCount, capturedAt) AS starCount
                FROM repositoryStarSnapshots
                GROUP BY repositoryId
            ) s
        INNER JOIN repositories r FINAL ON r.id = s.repositoryId
        WHERE isNull (r.deletedAt) AND r.enabled = true AND r.excluded = false
    {% end %}

NODE health_score_stars_benchmark
SQL >
    %
    SELECT
        channel,
        stars,
        CASE
            WHEN stars BETWEEN 0 AND 9
            THEN 0
            WHEN stars BETWEEN 10 AND 49
            THEN 1
            WHEN stars BETWEEN 50 AND 199
            THEN 2
            WHEN stars BETWEEN 200 AND 499
            THEN 3
            WHEN stars BETWEEN 500 AND 999
            THEN 4
            WHEN stars >= 1000
            THEN 5
            ELSE 0
        END AS starsBenchmark
    FROM repo_health_score_stars_score
