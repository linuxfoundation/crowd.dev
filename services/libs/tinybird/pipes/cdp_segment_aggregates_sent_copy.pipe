DESCRIPTION >
    Daily at 06:30 UTC, after the daily aggregate sinks: replaces cdp_segment_aggregates_sent_ds with the
    hash of every current v2 leaf aggregate, which is what the sinks just sent. Only when today's rows
    were prepared and both sinks succeeded today; otherwise it keeps yesterday's hashes, so the next run
    sends today's changes again. The leaf-hash nodes must stay identical to
    cdp_segment_aggregates_changes_copy and cdp_segment_aggregates_sent_seed_copy
    (linuxfoundation/lfx-cdp-insights-ops#1146).

NODE segment_hierarchy
SQL >
    SELECT
        id,
        argMax(parentId, updatedAt) AS parentId,
        argMax(grandparentId, updatedAt) AS grandparentId
    FROM segments
    GROUP BY id

NODE member_leaf
SQL >
    SELECT
        'member' AS kind,
        a.segmentId AS segmentId,
        a.memberId AS entityId,
        h.parentId AS parentId,
        h.grandparentId AS grandparentId,
        cityHash64(
            finalizeAggregation(a.activityCountState),
            finalizeAggregation(a.lastActiveState),
            arraySort(finalizeAggregation(a.activityTypesState)),
            arraySort(finalizeAggregation(a.activeOnState)),
            ifNotFinite(round(finalizeAggregation(a.averageSentimentState), 2), -1)
        ) AS hash
    FROM cdp_member_segment_aggregates_v2_ds a
    LEFT JOIN segment_hierarchy h ON h.id = a.segmentId

NODE organization_leaf
SQL >
    SELECT
        'organization' AS kind,
        a.segmentId AS segmentId,
        a.organizationId AS entityId,
        h.parentId AS parentId,
        h.grandparentId AS grandparentId,
        cityHash64(
            finalizeAggregation(a.joinedAtState),
            finalizeAggregation(a.lastActiveState),
            arraySort(finalizeAggregation(a.activeOnState)),
            finalizeAggregation(a.activityCountState),
            finalizeAggregation(a.memberCountState),
            ifNotFinite(round(finalizeAggregation(a.avgContributorEngagement), 2), -1)
        ) AS hash
    FROM cdp_organization_segment_aggregates_v2_ds a
    LEFT JOIN segment_hierarchy h ON h.id = a.segmentId
    WHERE a.organizationId != ''

NODE current_leaf
SQL >
    SELECT * FROM member_leaf
    UNION ALL
    SELECT * FROM organization_leaf

NODE sent_today
SQL >
    SELECT
        (
            SELECT count()
            FROM cdp_segment_aggregates_changes_ds
            WHERE stage = 'ready' AND runDate = today()
        )
        > 0
        AND (
            SELECT uniqExactIf(pipe_name, result = 'ok')
            FROM tinybird.sinks_ops_log
            WHERE
                timestamp >= toStartOfDay(now())
                AND pipe_name
                IN ('cdp_member_segment_aggregates_sink', 'cdp_organization_segment_aggregates_sink')
        )
        = 2 AS sentOk

NODE cdp_segment_aggregates_sent_copy_result
SQL >
    SELECT kind, segmentId, entityId, parentId, grandparentId, hash, now() AS updatedAt
    FROM current_leaf
    WHERE (SELECT sentOk FROM sent_today) = 1
    UNION ALL
    SELECT kind, segmentId, entityId, parentId, grandparentId, hash, updatedAt
    FROM cdp_segment_aggregates_sent_ds
    WHERE (SELECT sentOk FROM sent_today) = 0

TYPE COPY
TARGET_DATASOURCE cdp_segment_aggregates_sent_ds
COPY_MODE replace
COPY_SCHEDULE 30 6 * * *
