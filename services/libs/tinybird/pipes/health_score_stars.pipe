NODE health_score_stars_score
DESCRIPTION >
    Returns activeContributors for previous quarter per project

SQL >
    %
    SELECT segmentId, sum(stars) AS stars
    FROM
        (
            {% if defined(project) %}
                SELECT r.segmentId AS segmentId, toUInt64(sum(s.starCount)) AS stars
                FROM
                    (
                        SELECT repositoryId, argMax(starCount, (capturedAt, updatedAt)) AS starCount
                        FROM repositoryStarSnapshots
                        WHERE
                            repositoryId IN (
                                SELECT r2.id
                                FROM repositories r2 FINAL
                                INNER JOIN insightsProjects i2 FINAL ON r2.insightsProjectId = i2.id
                                WHERE
                                    isNull (r2.deletedAt)
                                    AND r2.enabled = true
                                    AND r2.excluded = false
                                    AND isNull (i2.deletedAt)
                                    AND i2.enabled = 1
                                    AND r2.segmentId = (SELECT segmentId FROM segments_filtered)
                                    {% if defined(repos) %}
                                        AND r2.url
                                        IN {{
                                            Array(
                                                repos,
                                                'String',
                                                description="Repository URLs",
                                                required=False,
                                            )
                                        }}
                                    {% end %}
                            )
                            {% if defined(startDate) %}
                                AND capturedAt
                                >= {{
                                    DateTime(
                                        startDate, description="Snapshot from date", required=False
                                    )
                                }}
                            {% end %}
                            {% if defined(endDate) %}
                                AND capturedAt
                                <= {{
                                    DateTime(
                                        endDate, description="Snapshot as of date", required=False
                                    )
                                }}
                            {% end %}
                        GROUP BY repositoryId
                    ) s
                INNER JOIN repositories r FINAL ON r.id = s.repositoryId
                INNER JOIN insightsProjects i FINAL ON r.insightsProjectId = i.id
                WHERE
                    isNull (r.deletedAt)
                    AND r.enabled = true
                    AND r.excluded = false
                    AND isNull (i.deletedAt)
                    AND i.enabled = 1
                    AND r.segmentId = (SELECT segmentId FROM segments_filtered)
                    {% if defined(repos) %}
                        AND r.url
                        IN {{ Array(repos, 'String', description="Repository URLs", required=False) }}
                    {% end %}
                GROUP BY r.segmentId
                UNION ALL
                SELECT segmentId, count() AS stars
                FROM activityRelations_bucket_routing
                WHERE
                    type = 'star'
                    AND platform != 'github'
                    AND segmentId = (SELECT segmentId FROM segments_filtered)
                    AND channel NOT IN (SELECT channel FROM repos_to_channels_excluded)
                    {% if defined(repos) %}
                        AND channel IN (SELECT channel FROM repos_to_channels)
                    {% end %}
                    {% if defined(startDate) %}
                        AND timestamp
                        > {{ DateTime(startDate, description="Filter after date", required=False) }}
                    {% end %}
                    {% if defined(endDate) %}
                        AND timestamp
                        < {{ DateTime(endDate, description="Filter before date", required=False) }}
                    {% end %}
                GROUP BY segmentId
            {% else %}
                SELECT r.segmentId AS segmentId, toUInt64(sum(s.starCount)) AS stars
                FROM
                    (
                        SELECT repositoryId, argMax(starCount, (capturedAt, updatedAt)) AS starCount
                        FROM repositoryStarSnapshots
                        GROUP BY repositoryId
                    ) s
                INNER JOIN repositories r FINAL ON r.id = s.repositoryId
                INNER JOIN insightsProjects i FINAL ON r.insightsProjectId = i.id
                WHERE
                    isNull (r.deletedAt)
                    AND r.enabled = true
                    AND r.excluded = false
                    AND isNull (i.deletedAt)
                    AND i.enabled = 1
                GROUP BY r.segmentId
                UNION ALL
                SELECT segmentId, count() AS stars
                FROM activityRelations_deduplicated_cleaned_bucket_union
                WHERE
                    type = 'star'
                    AND platform != 'github'
                    AND channel NOT IN (SELECT channel FROM repos_to_channels_excluded)
                GROUP BY segmentId
            {% end %}
        )
    GROUP BY segmentId

NODE health_score_stars_benchmark
SQL >
    %
    SELECT
        segmentId,
        stars,
        CASE
            WHEN stars BETWEEN 0 AND 9
            THEN 0
            WHEN stars BETWEEN 10 AND 49
            THEN 1
            WHEN stars BETWEEN 50 AND 199
            THEN 2
            WHEN stars BETWEEN 200 AND 499
            THEN 3
            WHEN stars BETWEEN 500 AND 999
            THEN 4
            WHEN stars >= 1000
            THEN 5
            ELSE 0
        END AS starsBenchmark
    FROM health_score_stars_score
