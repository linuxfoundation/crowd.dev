DESCRIPTION >
    Hourly: aggregates the PR events of the last day before the table's latest `snapshotId`, merges them onto each PR's
    current row and replaces the table. Every merge rule is idempotent, so re-reading the overlap is safe.

NODE pr_window
DESCRIPTION >
    Lower `updatedAt` bound of this run. Ignores `snapshotId`s more than two hours in the future so a bad `updatedAt`
    cannot move the window past unread events. On an empty table `max` returns epoch and the subtraction wraps to 2106,
    so the window is empty and the copy writes nothing.

SQL >
    SELECT max(snapshotId) - INTERVAL 1 DAY AS fromUpdatedAt
    FROM pull_requests_analyzed
    WHERE snapshotId <= now() + INTERVAL 2 HOUR

NODE pr_delta_events
DESCRIPTION >
    Latest version of each PR event in the window, so member merges show the new `memberId`. The `snapshotId` bound
    prunes daily snapshots.

SQL >
    SELECT
        activityId,
        if(
            type IN (
                'pull_request-opened',
                'merge_request-opened',
                'changeset-created',
                'changeset-abandoned',
                'changeset-merged'
            ),
            sourceId,
            if(type = 'patchset_approval-created', splitByChar('-', sourceParentId)[1], sourceParentId)
        ) AS prSourceId,
        sourceId,
        lower(channel) AS channel,
        domain(channel) AS host,
        timestamp AS ts,
        segmentId,
        gitChangedLinesBucket,
        memberId,
        organizationId,
        platform,
        updatedAt,
        type,
        pullRequestReviewState
    FROM activityRelations_enrich_snapshot_MV_ds
    WHERE
        snapshotId >= toStartOfDay((SELECT fromUpdatedAt FROM pr_window))
        AND updatedAt >= (SELECT fromUpdatedAt FROM pr_window)
        AND type IN (
            'pull_request-opened',
            'merge_request-opened',
            'changeset-created',
            'pull_request-assigned',
            'merge_request-assigned',
            'pull_request-review-requested',
            'merge_request-review-requested',
            'pull_request-reviewed',
            'merge_request-review-changes-requested',
            'patchset-created',
            'merge_request-review-approved',
            'patchset_approval-created',
            'pull_request-closed',
            'merge_request-closed',
            'changeset-closed',
            'changeset-abandoned',
            'pull_request-merged',
            'merge_request-merged',
            'changeset-merged'
        )
    ORDER BY updatedAt DESC
    LIMIT 1 BY activityId

NODE pr_delta_authors
DESCRIPTION >
    Every known author id of each PR in the window: from its current rows and from opened events in the window.

SQL >
    SELECT prSourceId, host, groupUniqArray(memberId) AS authorIds
    FROM
        (
            SELECT sourceId AS prSourceId, domain(channel) AS host, memberId
            FROM pull_requests_analyzed
            WHERE
                memberId != ''
                AND (sourceId, domain(channel)) IN (SELECT prSourceId, host FROM pr_delta_events)
            UNION ALL
            SELECT prSourceId, host, memberId
            FROM pr_delta_events
            WHERE
                type IN ('pull_request-opened', 'merge_request-opened', 'changeset-created')
                AND memberId != ''
        )
    GROUP BY prSourceId, host

NODE pr_delta_non_author
DESCRIPTION >
    Drops reviews and approvals by any of the PR's author ids, or by anyone when the author is unknown. Other event types
    pass through.

SQL >
    SELECT e.*
    FROM pr_delta_events AS e
    LEFT JOIN pr_delta_authors AS a ON a.prSourceId = e.prSourceId AND a.host = e.host
    WHERE
        e.type NOT IN (
            'pull_request-reviewed',
            'merge_request-review-changes-requested',
            'merge_request-review-approved',
            'patchset_approval-created'
        )
        OR (e.memberId != '' AND notEmpty(a.authorIds) AND NOT has(a.authorIds, e.memberId))

NODE pr_delta_opened
DESCRIPTION >
    Identity of each PR row opened in the window, one per PR, segment and repository.

SQL >
    SELECT
        prSourceId,
        segmentId,
        channel,
        argMin(activityId, ts) AS id,
        argMin(gitChangedLinesBucket, ts) AS gitChangedLinesBucket,
        argMin(memberId, ts) AS memberId,
        argMin(organizationId, ts) AS organizationId,
        argMin(platform, ts) AS platform,
        min(ts) AS openedAt
    FROM pr_delta_events
    WHERE
        type IN ('pull_request-opened', 'merge_request-opened', 'changeset-created')
        AND prSourceId != ''
    GROUP BY prSourceId, segmentId, channel

NODE pr_delta_lifecycle
DESCRIPTION >
    Lifecycle per PR and host, so every row of the PR gets it across segments and renamed repositories. Gerrit change
    numbers repeat across hosts. `numberOfPatchsets` is the highest Gerrit patchset number.

SQL >
    SELECT
        prSourceId,
        host,
        toInt64(
            maxIf(toUInt32OrZero(splitByChar('-', sourceId)[-1]), type = 'patchset-created')
        ) AS numberOfPatchsets,
        minIf(ts, type IN ('pull_request-assigned', 'merge_request-assigned')) AS assignedAt,
        minIf(
            ts, type IN ('pull_request-review-requested', 'merge_request-review-requested')
        ) AS reviewRequestedAt,
        minIf(
            ts,
            type IN (
                'pull_request-reviewed',
                'merge_request-review-changes-requested',
                'merge_request-review-approved',
                'patchset_approval-created'
            )
        ) AS reviewedAt,
        minIf(
            ts,
            (type = 'pull_request-reviewed' AND pullRequestReviewState = 'APPROVED')
            OR type IN ('merge_request-review-approved', 'patchset_approval-created')
        ) AS approvedAt,
        minIf(
            ts,
            type IN (
                'pull_request-closed', 'merge_request-closed', 'changeset-closed', 'changeset-abandoned'
            )
        ) AS closedAt,
        minIf(
            ts, type IN ('pull_request-merged', 'merge_request-merged', 'changeset-merged')
        ) AS mergedAt,
        minIf(
            ts,
            type IN (
                'pull_request-closed',
                'pull_request-merged',
                'merge_request-closed',
                'merge_request-merged',
                'changeset-merged',
                'changeset-closed',
                'changeset-abandoned'
            )
        ) AS resolvedAt,
        toDateTime(toStartOfHour(max(updatedAt))) + INTERVAL 1 HOUR AS snapshotId
    FROM pr_delta_non_author
    WHERE prSourceId != ''
    GROUP BY prSourceId, host

NODE pr_touched_rows
DESCRIPTION >
    Current rows of each PR in the window, one per segment and repository, preferring a real `openedAt` over the epoch
    fallback.

SQL >
    SELECT *
    FROM pull_requests_analyzed
    WHERE (sourceId, domain(channel)) IN (SELECT prSourceId, host FROM pr_delta_lifecycle)
    ORDER BY openedAt = toDateTime(0), snapshotId DESC
    LIMIT 1 BY sourceId, segmentId, channel

NODE pr_existing_lifecycle
DESCRIPTION >
    Lifecycle already stored for each PR and host, merged across its rows, so a row added for another segment or a
    renamed repository starts from it.

SQL >
    SELECT
        sourceId,
        domain(channel) AS host,
        min(assignedAt) AS assignedAt,
        min(reviewRequestedAt) AS reviewRequestedAt,
        min(reviewedAt) AS reviewedAt,
        min(approvedAt) AS approvedAt,
        min(closedAt) AS closedAt,
        min(mergedAt) AS mergedAt,
        min(resolvedAt) AS resolvedAt,
        max(numberOfPatchsets) AS numberOfPatchsets
    FROM pr_touched_rows
    GROUP BY sourceId, host

NODE pr_targets
DESCRIPTION >
    Rows to write for the PRs in the window: every current row, plus a new row for each opened event without one.
    Identity fields keep the current value when set; lifecycle comes from `pr_existing_lifecycle`.

SQL >
    SELECT
        if(existing.sourceId != '', existing.sourceId, opened.prSourceId) AS sourceId,
        if(existing.sourceId != '', existing.segmentId, opened.segmentId) AS segmentId,
        if(existing.sourceId != '', existing.channel, opened.channel) AS channel,
        if(existing.id != '', existing.id, opened.id) AS id,
        if(existing.openedAt != toDateTime(0), existing.openedAt, opened.openedAt) AS openedAt,
        if(existing.memberId != '', existing.memberId, opened.memberId) AS memberId,
        if(
            existing.organizationId != '', existing.organizationId, opened.organizationId
        ) AS organizationId,
        if(
            existing.gitChangedLinesBucket != '',
            existing.gitChangedLinesBucket,
            opened.gitChangedLinesBucket
        ) AS gitChangedLinesBucket,
        if(existing.platform != '', existing.platform, opened.platform) AS platform,
        existing.snapshotId AS snapshotId
    FROM pr_touched_rows AS existing
    FULL OUTER JOIN
        pr_delta_opened AS opened
        ON existing.sourceId = opened.prSourceId
        AND existing.segmentId = opened.segmentId
        AND existing.channel = opened.channel

NODE pr_merged
DESCRIPTION >
    Merges the PR's window lifecycle onto each of its rows: the earliest timestamp wins and epoch means unset. A PR with
    no opened event yet has no rows and is skipped until the opened event arrives.

SQL >
    SELECT
        t.id AS id,
        t.sourceId AS sourceId,
        t.openedAt AS openedAt,
        t.segmentId AS segmentId,
        t.channel AS channel,
        t.memberId AS memberId,
        t.organizationId AS organizationId,
        t.gitChangedLinesBucket AS gitChangedLinesBucket,
        if(
            new.assignedAt = toDateTime(0),
            cur.assignedAt,
            least(ifNull(cur.assignedAt, new.assignedAt), new.assignedAt)
        ) AS assignedAt,
        if(
            new.reviewRequestedAt = toDateTime(0),
            cur.reviewRequestedAt,
            least(ifNull(cur.reviewRequestedAt, new.reviewRequestedAt), new.reviewRequestedAt)
        ) AS reviewRequestedAt,
        if(
            new.reviewedAt = toDateTime(0),
            cur.reviewedAt,
            least(ifNull(cur.reviewedAt, new.reviewedAt), new.reviewedAt)
        ) AS reviewedAt,
        if(
            new.approvedAt = toDateTime(0),
            cur.approvedAt,
            least(ifNull(cur.approvedAt, new.approvedAt), new.approvedAt)
        ) AS approvedAt,
        if(
            new.closedAt = toDateTime(0),
            cur.closedAt,
            least(ifNull(cur.closedAt, new.closedAt), new.closedAt)
        ) AS closedAt,
        if(
            new.mergedAt = toDateTime(0),
            cur.mergedAt,
            least(ifNull(cur.mergedAt, new.mergedAt), new.mergedAt)
        ) AS mergedAt,
        if(
            new.resolvedAt = toDateTime(0),
            cur.resolvedAt,
            least(ifNull(cur.resolvedAt, new.resolvedAt), new.resolvedAt)
        ) AS resolvedAt,
        if(
            assignedAt IS NULL, NULL, toUnixTimestamp(assignedAt) - toUnixTimestamp(openedAt)
        ) AS assignedInSeconds,
        if(
            reviewRequestedAt IS NULL,
            NULL,
            toUnixTimestamp(reviewRequestedAt) - toUnixTimestamp(openedAt)
        ) AS reviewRequestedInSeconds,
        if(
            reviewedAt IS NULL, NULL, toUnixTimestamp(reviewedAt) - toUnixTimestamp(openedAt)
        ) AS reviewedInSeconds,
        if(
            closedAt IS NULL, NULL, toUnixTimestamp(closedAt) - toUnixTimestamp(openedAt)
        ) AS closedInSeconds,
        if(
            mergedAt IS NULL, NULL, toUnixTimestamp(mergedAt) - toUnixTimestamp(openedAt)
        ) AS mergedInSeconds,
        if(
            resolvedAt IS NULL, NULL, toUnixTimestamp(resolvedAt) - toUnixTimestamp(openedAt)
        ) AS resolvedInSeconds,
        t.platform AS platform,
        if(
            new.numberOfPatchsets > 0,
            greatest(ifNull(cur.numberOfPatchsets, 0), new.numberOfPatchsets),
            cur.numberOfPatchsets
        ) AS numberOfPatchsets,
        greatest(t.snapshotId, new.snapshotId) AS snapshotId
    FROM pr_targets AS t
    LEFT JOIN pr_existing_lifecycle AS cur ON cur.sourceId = t.sourceId AND cur.host = domain(t.channel)
    LEFT JOIN pr_delta_lifecycle AS new ON new.prSourceId = t.sourceId AND new.host = domain(t.channel)
    WHERE t.id != ''

NODE pr_analysis_results
DESCRIPTION >
    Updated rows for the PRs in the window, plus every other row unchanged. Every current row of a PR in
    `pr_delta_lifecycle` is in `pr_merged`, so the exclusion reads only the aggregated delta.

SQL >
    SELECT *
    FROM pr_merged
    UNION ALL
    SELECT *
    FROM pull_requests_analyzed
    WHERE (sourceId, domain(channel)) NOT IN (SELECT prSourceId, host FROM pr_delta_lifecycle)

TYPE COPY
TARGET_DATASOURCE pull_requests_analyzed
COPY_MODE replace
COPY_SCHEDULE 20 * * * *
