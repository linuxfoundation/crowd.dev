DESCRIPTION >
    Full rebuild of `pull_requests_analyzed` with the incremental copy's rules. Each bucket run replaces its PRs and keeps
    every other row (see lambda-architecture.md):
    tb pipe copy run pull_request_analysis_initial_snapshot --param bucket_id=N --param num_buckets=10 --wait

NODE pr_recent_events
DESCRIPTION >
    Latest version of each PR event in the snapshot MV, which holds the days the daily bucket merge has not reached.

SQL >
    SELECT
        activityId,
        sourceId,
        sourceParentId,
        channel,
        timestamp,
        segmentId,
        gitChangedLinesBucket,
        memberId,
        organizationId,
        platform,
        updatedAt,
        type,
        pullRequestReviewState
    FROM activityRelations_enrich_snapshot_MV_ds
    WHERE
        type IN (
            'pull_request-opened',
            'merge_request-opened',
            'changeset-created',
            'pull_request-assigned',
            'merge_request-assigned',
            'pull_request-review-requested',
            'merge_request-review-requested',
            'pull_request-reviewed',
            'merge_request-review-changes-requested',
            'patchset-created',
            'merge_request-review-approved',
            'patchset_approval-created',
            'pull_request-closed',
            'merge_request-closed',
            'changeset-closed',
            'changeset-abandoned',
            'pull_request-merged',
            'merge_request-merged',
            'changeset-merged'
        )
    ORDER BY updatedAt DESC
    LIMIT 1 BY activityId

NODE pr_events
DESCRIPTION >
    PR events of this bucket, one version per activity: the snapshot MV's latest version, else the history's. Buckets
    split by PR, so all of a PR's events land in one run.

SQL >
    %
    SELECT
        activityId,
        if(
            type IN (
                'pull_request-opened',
                'merge_request-opened',
                'changeset-created',
                'changeset-abandoned',
                'changeset-merged'
            ),
            sourceId,
            if(type = 'patchset_approval-created', splitByChar('-', sourceParentId)[1], sourceParentId)
        ) AS prSourceId,
        sourceId,
        lower(channel) AS channel,
        domain(channel) AS host,
        timestamp AS ts,
        segmentId,
        gitChangedLinesBucket,
        memberId,
        organizationId,
        platform,
        updatedAt,
        type,
        pullRequestReviewState
    FROM
        (
            SELECT
                activityId, sourceId, sourceParentId, channel, timestamp, segmentId, gitChangedLinesBucket,
                memberId, organizationId, platform, updatedAt, type, pullRequestReviewState
            FROM activityRelations_enriched_deduplicated_bucket_union
            WHERE activityId NOT IN (SELECT activityId FROM pr_recent_events)
            UNION ALL
            SELECT *
            FROM pr_recent_events
        )
    WHERE
        type IN (
            'pull_request-opened',
            'merge_request-opened',
            'changeset-created',
            'pull_request-assigned',
            'merge_request-assigned',
            'pull_request-review-requested',
            'merge_request-review-requested',
            'pull_request-reviewed',
            'merge_request-review-changes-requested',
            'patchset-created',
            'merge_request-review-approved',
            'patchset_approval-created',
            'pull_request-closed',
            'merge_request-closed',
            'changeset-closed',
            'changeset-abandoned',
            'pull_request-merged',
            'merge_request-merged',
            'changeset-merged'
        )
        AND prSourceId != ''
        {% if defined(bucket_id) %}
            AND cityHash64(prSourceId)
            % {{ UInt8(num_buckets, 5, description="Total number of buckets", required=False) }}
            = {{
                UInt8(
                    bucket_id,
                    0,
                    description="Bucket index to process (0 to num_buckets-1)",
                    required=False,
                )
            }}
        {% end %}

NODE pr_authors
DESCRIPTION >
    Every author id of each PR, from its opened events.

SQL >
    SELECT prSourceId, host, groupUniqArray(memberId) AS authorIds
    FROM pr_events
    WHERE
        type IN ('pull_request-opened', 'merge_request-opened', 'changeset-created') AND memberId != ''
    GROUP BY prSourceId, host

NODE pr_non_author
DESCRIPTION >
    Drops reviews and approvals by any of the PR's author ids, or by anyone when the author is unknown. Other event types
    pass through.

SQL >
    SELECT e.*
    FROM pr_events AS e
    LEFT JOIN pr_authors AS a ON a.prSourceId = e.prSourceId AND a.host = e.host
    WHERE
        e.type NOT IN (
            'pull_request-reviewed',
            'merge_request-review-changes-requested',
            'merge_request-review-approved',
            'patchset_approval-created'
        )
        OR (e.memberId != '' AND notEmpty(a.authorIds) AND NOT has(a.authorIds, e.memberId))

NODE pr_opened
DESCRIPTION >
    One row per PR, segment and repository, with the identity of its first opened event.

SQL >
    SELECT
        prSourceId,
        segmentId,
        channel,
        argMin(activityId, ts) AS id,
        argMin(gitChangedLinesBucket, ts) AS gitChangedLinesBucket,
        argMin(memberId, ts) AS memberId,
        argMin(organizationId, ts) AS organizationId,
        argMin(platform, ts) AS platform,
        min(ts) AS openedAt
    FROM pr_events
    WHERE type IN ('pull_request-opened', 'merge_request-opened', 'changeset-created') AND prSourceId != ''
    GROUP BY prSourceId, segmentId, channel

NODE pr_lifecycle
DESCRIPTION >
    Lifecycle per PR and host, so every row of the PR gets it across segments and renamed repositories. Gerrit change
    numbers repeat across hosts. `numberOfPatchsets` is the highest Gerrit patchset number.

SQL >
    SELECT
        prSourceId,
        host,
        toInt64(
            maxIf(toUInt32OrZero(splitByChar('-', sourceId)[-1]), type = 'patchset-created')
        ) AS numberOfPatchsets,
        minIf(ts, type IN ('pull_request-assigned', 'merge_request-assigned')) AS assignedAt,
        minIf(
            ts, type IN ('pull_request-review-requested', 'merge_request-review-requested')
        ) AS reviewRequestedAt,
        minIf(
            ts,
            type IN (
                'pull_request-reviewed',
                'merge_request-review-changes-requested',
                'merge_request-review-approved',
                'patchset_approval-created'
            )
        ) AS reviewedAt,
        minIf(
            ts,
            (type = 'pull_request-reviewed' AND pullRequestReviewState = 'APPROVED')
            OR type IN ('merge_request-review-approved', 'patchset_approval-created')
        ) AS approvedAt,
        minIf(
            ts,
            type IN (
                'pull_request-closed', 'merge_request-closed', 'changeset-closed', 'changeset-abandoned'
            )
        ) AS closedAt,
        minIf(
            ts, type IN ('pull_request-merged', 'merge_request-merged', 'changeset-merged')
        ) AS mergedAt,
        minIf(
            ts,
            type IN (
                'pull_request-closed',
                'pull_request-merged',
                'merge_request-closed',
                'merge_request-merged',
                'changeset-merged',
                'changeset-closed',
                'changeset-abandoned'
            )
        ) AS resolvedAt,
        toDateTime(toStartOfHour(max(updatedAt))) + INTERVAL 1 HOUR AS snapshotId
    FROM pr_non_author
    WHERE prSourceId != ''
    GROUP BY prSourceId, host

NODE pr_rebuilt
DESCRIPTION >
    The PR's lifecycle on each of its rows. Aggregates with no matching event (`minIf` over no rows) come back as epoch
    and are stored as NULL.

SQL >
    SELECT
        o.id AS id,
        o.prSourceId AS sourceId,
        o.openedAt AS openedAt,
        o.segmentId AS segmentId,
        o.channel AS channel,
        o.memberId AS memberId,
        o.organizationId AS organizationId,
        o.gitChangedLinesBucket AS gitChangedLinesBucket,
        if(l.assignedAt = toDateTime(0), NULL, l.assignedAt) AS assignedAt,
        if(l.reviewRequestedAt = toDateTime(0), NULL, l.reviewRequestedAt) AS reviewRequestedAt,
        if(l.reviewedAt = toDateTime(0), NULL, l.reviewedAt) AS reviewedAt,
        if(l.approvedAt = toDateTime(0), NULL, l.approvedAt) AS approvedAt,
        if(l.closedAt = toDateTime(0), NULL, l.closedAt) AS closedAt,
        if(l.mergedAt = toDateTime(0), NULL, l.mergedAt) AS mergedAt,
        if(l.resolvedAt = toDateTime(0), NULL, l.resolvedAt) AS resolvedAt,
        if(
            assignedAt IS NULL, NULL, toUnixTimestamp(assignedAt) - toUnixTimestamp(openedAt)
        ) AS assignedInSeconds,
        if(
            reviewRequestedAt IS NULL,
            NULL,
            toUnixTimestamp(reviewRequestedAt) - toUnixTimestamp(openedAt)
        ) AS reviewRequestedInSeconds,
        if(
            reviewedAt IS NULL, NULL, toUnixTimestamp(reviewedAt) - toUnixTimestamp(openedAt)
        ) AS reviewedInSeconds,
        if(
            closedAt IS NULL, NULL, toUnixTimestamp(closedAt) - toUnixTimestamp(openedAt)
        ) AS closedInSeconds,
        if(
            mergedAt IS NULL, NULL, toUnixTimestamp(mergedAt) - toUnixTimestamp(openedAt)
        ) AS mergedInSeconds,
        if(
            resolvedAt IS NULL, NULL, toUnixTimestamp(resolvedAt) - toUnixTimestamp(openedAt)
        ) AS resolvedInSeconds,
        o.platform AS platform,
        if(l.numberOfPatchsets > 0, l.numberOfPatchsets, NULL) AS numberOfPatchsets,
        l.snapshotId AS snapshotId
    FROM pr_opened AS o
    LEFT JOIN pr_lifecycle AS l ON l.prSourceId = o.prSourceId AND l.host = domain(o.channel)

NODE pr_analysis_results
DESCRIPTION >
    Rebuilt rows of this bucket plus the current rows of every other bucket. Rows of this bucket whose PR has no opened
    event left in the history are dropped.

SQL >
    %
    SELECT *
    FROM pr_rebuilt
    {% if defined(bucket_id) %}
        UNION ALL
        SELECT *
        FROM pull_requests_analyzed
        WHERE
            cityHash64(sourceId)
            % {{ UInt8(num_buckets, 5, description="Total number of buckets", required=False) }}
            != {{
                UInt8(
                    bucket_id,
                    0,
                    description="Bucket index to process (0 to num_buckets-1)",
                    required=False,
                )
            }}
    {% end %}

TYPE COPY
TARGET_DATASOURCE pull_requests_analyzed
COPY_MODE replace
COPY_SCHEDULE @on-demand
