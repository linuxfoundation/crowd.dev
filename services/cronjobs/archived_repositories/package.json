{
  "name": "repository-archive-checker",
  "private": true,
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "build": "tsc",
    "start-main": "pnpm run build && node dist/main.js",
    "start-workers": "pnpm run build && node dist/workers.js",
    "dev-main": "tsx --watch src/main.ts",
    "dev-workers": "tsx --watch src/workers.ts",
    "test": "vitest run --reporter verbose"
  },
  "dependencies": {
    "bullmq": "^5.56.9",
    "dotenv": "^16.6.1",
    "ofetch": "^1.4.1",
    "pg": "^8.16.3",
    "tsx": "^4.20.3"
  },
  "devDependencies": {
    "@types/node": "^24.2.0",
    "@types/pg": "^8.15.5",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  },
  "packageManager": "pnpm@11.22.0+sha512.1ff870c4c6133dfd88fb2afc46dd13d47f09c9794b438c6fdb47ca98caf3bc16381ee0be93a091b8e3824cf01f889f46d7d9e20910fb0be1ab0fb5baa80dd621"
}
